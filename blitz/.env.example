# ===========================================
# Blitz Protocol – Environment variables
# Copy this file to .env.local and fill in values.
# ===========================================

# --- Database (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Encryption (required – used to encrypt API keys stored in DB) ---
# Use a long random string, e.g.: openssl rand -hex 32
API_ENCRYPTION_KEY=your_32_char_or_longer_secret

# --- Auth – Clerk (required) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- AI / RAG (required for full features) ---
GROQ_API_KEY=your_groq_api_key
PINECONE_API_KEY=your_pinecone_api_key

# --- Pinecone (optional – have defaults) ---
PINECONE_INDEX_NAME=blitz-rag
# PINECONE_INDEX_HOST=optional-host-if-using-special-index-url

# --- RAG tuning (optional – defaults shown) ---
# EMBEDDING_MODEL=Xenova/gte-small
# EMBEDDING_DIMENSION=384
# DEFAULT_MATCH_THRESHOLD=0.7
# DEFAULT_MATCH_COUNT=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200

# --- GenAI Intent node ---
# Per-workflow API keys (Perplexity or Gemini) are set in the workflow UI
# and encrypted with API_ENCRYPTION_KEY. No env vars needed for those.
